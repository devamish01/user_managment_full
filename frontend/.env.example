# =====================================================================
# API configuration
# =====================================================================

# Selects which API client the application uses at runtime.
#   mock    -> in-memory mock backend (default, no server required)
#   backend -> real HTTP backend at VITE_API_BASE_URL
VITE_API_MODE=mock

# Base URL of the real backend, used only when VITE_API_MODE=backend.
# Example: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
